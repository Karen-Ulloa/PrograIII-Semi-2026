# Copia este archivo como ".env" (sin la palabra example) y completa los valores.
# El archivo .env NO se sube a GitHub.

# Clave de Google AI Studio (https://aistudio.google.com/apikey). Necesaria para el asistente de IA.
GEMINI_API_KEY=pega_aqui_tu_clave

# Opcional: modelos del asistente, en orden de preferencia (si uno está saturado se usa el siguiente).
GEMINI_MODELOS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash

# Opcional: correo de Gmail con contraseña de aplicación, para recuperar contraseñas.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
